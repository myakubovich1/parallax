# Server only. Real keys belong in environment settings or ignored .env.local.
# Never use VITE_ for credentials: those variables enter browser code.
PARALLAX_PROVIDER=gemini
PARALLAX_GEMINI_API_KEY=
PARALLAX_GEMINI_MODEL=gemini-3.1-flash-lite
# Optional paid provider: only used if PARALLAX_PROVIDER=openai explicitly.
PARALLAX_API_KEY=
PARALLAX_MODEL=gpt-4.1-mini
