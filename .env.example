# Server only. Real keys belong in environment settings or ignored .env.local.
# Never use VITE_ for credentials: those variables enter browser code.
PARALLAX_PROVIDER=openai
# Optional alternative: set PARALLAX_PROVIDER=gemini to use these instead.
# PARALLAX_GEMINI_API_KEY=
# PARALLAX_GEMINI_MODEL=gemini-3.1-flash-lite
# OpenAI credentials and model. Add the real key privately.
PARALLAX_API_KEY=
PARALLAX_MODEL=gpt-5.6-sol

# Robot help assistant: Google AI Studio API key with access to hosted Gemma.
# Independent of the lesson-generation provider and keys above. Server only.
PARALLAX_HELP_API_KEY=
PARALLAX_HELP_MODEL=gemma-4-26b-a4b-it
